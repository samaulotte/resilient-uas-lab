    given-names: Samuel
    email: samuel.aulotte@dtsc.be
    affiliation: DTSC
version: 0.1.0
date-released: "2026-09-20"
license: Apache-2.0
keywords:
  - resilience engineering
  - chaos engineering
  - autonomous systems
  - unmanned aircraft systems
  - fault injection
  - PX4
  - Gazebo
  - simulation
