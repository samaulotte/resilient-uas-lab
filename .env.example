# Resilient UAS Lab - environment configuration for Docker Compose.
# Copy to `.env` (never committed). Every variable has a working local default, so the
# mock demo runs without changing anything here.

# ---------------------------------------------------------------- platform
# development | test | production
RESLAB_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
RESLAB_LOG_LEVEL=INFO
# json (containers) | console (local development)
RESLAB_LOG_FORMAT=json
# Version and commit recorded in run provenance and image labels.
RESLAB_VERSION=0.1.0
RESLAB_GIT_COMMIT=

# ---------------------------------------------------------------- gateway
# Browser entry point: http://localhost:${RESLAB_GATEWAY_PORT}
RESLAB_GATEWAY_PORT=8080
# Browser origins allowed by the API (comma separated). The gateway serves the UI and the
# API on the same origin, so this only matters when running the web app separately.
RESLAB_API_CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ---------------------------------------------------------------- database
POSTGRES_USER=reslab
POSTGRES_PASSWORD=reslab
POSTGRES_DB=reslab

# ---------------------------------------------------------------- artifact store (S3 API)
# Credentials for the bundled S3-compatible object store. Any S3 endpoint can be used by
# pointing RESLAB_S3_ENDPOINT_URL at it (see docs/deployment.md).
S3_ACCESS_KEY=reslab
S3_SECRET_KEY=reslab-secret
S3_BUCKET=reslab-artifacts

# ---------------------------------------------------------------- runners
RESLAB_RUNNER_ID=runner-1
# Runs executed concurrently by one runner container (scale containers instead for isolation).
RESLAB_RUNNER_CONCURRENCY=1
# Seconds without heartbeat or progress before a run is failed by the orchestrator.
RESLAB_RUNNER_STALE_AFTER_SECONDS=45
# Seconds a queued run waits for a runner before it is failed.
RESLAB_QUEUED_TIMEOUT_SECONDS=300
# Seconds a run may spend preparing its target (adapter connecting) before it is failed.
# Keep above the adapters' connection timeouts, which fail first with a precise reason.
RESLAB_PREPARING_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------- profile: sim (PX4 SITL)
# Official PX4 SITL + Gazebo Harmonic image, pinned by digest. Override to use another build.
PX4_SIM_IMAGE=px4io/px4-sitl-gazebo@sha256:aa4bbf35f0bd6bdb3269cc96e317c8e78b87f1fc769c734c0818094074e1cc0a
PX4_SIM_MODEL=gz_x500
PX4_GZ_WORLD=default
PX4_SIM_SPEED_FACTOR=1
RESLAB_SIM_RUNNER_ID=runner-sim-1
RESLAB_PX4_MAVSDK_ADDRESS=udpin://0.0.0.0:14550
RESLAB_PX4_CONNECTION_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------- profile: observability
RESLAB_GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
