{
  "title": "Resilient UAS Lab - Platform",
  "uid": "reslab-platform",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["resilient-uas-lab", "platform"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active runs",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "reslab_orchestrator_active_runs", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs finalized (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(increase(reslab_orchestrator_runs_finalized_total[1h])) by (state)", "legendFormat": "{{state}}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runner active runs",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(reslab_runner_active_runs)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API requests / s",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(rate(reslab_api_requests_total[5m]))", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Bus messages processed by type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "sum(rate(reslab_orchestrator_messages_total[1m])) by (type)", "legendFormat": "{{type}}", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(reslab_api_request_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}", "refId": "A" }]
    }
  ]
}
