  "$id": "https://resilient-uas.dev/schemas/report/v1.json",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/ReportScenario"
    },
    "target": {
      "$ref": "#/$defs/ReportTarget"
    },
    "run": {
      "$ref": "#/$defs/ReportRun"
    },
    "result": {
      "$ref": "#/$defs/BenchmarkResult"
    },
    "resilience_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Resilience Score",
      "type": "number"
    },
    "hard_gate_result": {
      "$ref": "#/$defs/BenchmarkResult"
    },
    "summary": {
      "$ref": "#/$defs/ReportSummary"
    },
    "score": {
      "$ref": "#/$defs/ScoreResult"
    },
    "metrics": {
      "$ref": "#/$defs/MetricsResult"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/AssertionResult"
      },
      "title": "Assertions",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/RunEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "subsystem_timeline": {
      "items": {
        "$ref": "#/$defs/ComponentStateInterval"
      },
      "title": "Subsystem Timeline",
      "type": "array"
    },
    "planned_path": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlannedPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "actual_path": {
      "description": "Downsampled trajectory",
      "items": {
        "$ref": "#/$defs/PathPoint"
      },
      "title": "Actual Path",
      "type": "array"
    },
    "topology": {
      "$ref": "#/$defs/SystemTopology"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ReportArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "run_id",
    "generated_at",
    "scenario",
    "target",
    "run",
    "result",
    "resilience_score",
    "hard_gate_result",
    "summary",
    "score",
    "metrics",
    "assertions",
    "events",
    "subsystem_timeline",
    "planned_path",
    "actual_path",
    "topology",
    "artifacts",
    "provenance"
  ],
  "title": "ResilienceReport",
  "type": "object"
}
