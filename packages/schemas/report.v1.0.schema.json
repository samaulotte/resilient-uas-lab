    "RecoveryRecord": {
      "properties": {
        "subsystem": {
          "title": "Subsystem",
          "type": "string"
        },
        "fault_state": {
          "$ref": "#/$defs/ComponentState"
        },
        "fault_started_at": {
          "title": "Fault Started At",
          "type": "number"
        },
        "recovered_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recovered At"
        },
        "fault_duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds from fault start to recovery",
          "title": "Fault Duration"
        },
        "recovery_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds needed to recover once the disturbance ended: measured from the moment the causing injection was cleared (or from fault start for transient and self-inflicted faults) to the return to a healthy state",
          "title": "Recovery Time"
        },
        "disturbance_cleared_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the causing injection was cleared, if bounded",
          "title": "Disturbance Cleared At"
        },
        "caused_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Scenario event id when attributable",
          "title": "Caused By"
        },
        "direct": {
          "description": "True when the fault is the injected subsystem itself",
          "title": "Direct",
          "type": "boolean"
        },
        "recovery_expected": {
          "description": "False when the injected effect persisted until scenario end",
          "title": "Recovery Expected",
          "type": "boolean"
        }
      },
      "required": [
        "subsystem",
        "fault_state",
        "fault_started_at",
        "recovered_at",
        "fault_duration",
        "recovery_time",
        "caused_by",
        "direct",
        "recovery_expected"
      ],
      "title": "RecoveryRecord",
      "type": "object"
    },
