{
  "name": "@reslab/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Resilient UAS Lab API, generated from the OpenAPI document.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../schemas/openapi.json -o ./src/schema.d.ts --alphabetize --export-type",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint rules for generated client\"",
    "test": "echo \"no tests for generated client\""
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
