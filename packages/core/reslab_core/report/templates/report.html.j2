<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Resilience Report - {{ report.scenario.name }} - {{ report.run_id[:8] }}</title>
<style>
  :root {
    --bg: #070b10; --panel: #0e151d; --panel-2: #121b25; --border: #1d2937;
    --text: #e6edf3; --muted: #8b9bab; --dim: #5d6b7a;
    --info: #4aa3df; --ok: #2fbf71; --warn: #e0a52a; --bad: #d9534f;
    --mono: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
    --sans: Inter, "Segoe UI", system-ui, -apple-system, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 14px; line-height: 1.45; }
  header { padding: 28px 40px 20px; border-bottom: 1px solid var(--border); background: linear-gradient(180deg, #0c131b, var(--bg)); }
  .brand { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
  h1 { margin: 6px 0 4px; font-size: 24px; font-weight: 600; }
  h2 { font-size: 14px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; font-weight: 600; }
  main { padding: 24px 40px 48px; max-width: 1280px; margin: 0 auto; }
  .grid { display: grid; gap: 16px; }
  .cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 900px) { .cols-4, .cols-3, .cols-2 { grid-template-columns: 1fr; } main, header { padding-left: 16px; padding-right: 16px; } }
  .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 16px 18px; }
  .kpi .label { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .kpi .value { font-family: var(--mono); font-size: 26px; font-weight: 600; margin-top: 4px; }
  .kpi .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .mono { font-family: var(--mono); }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; border: 1px solid transparent; }
  .badge.pass, .badge.passed, .badge.ok { color: var(--ok); border-color: rgba(47,191,113,.35); background: rgba(47,191,113,.08); }
  .badge.fail, .badge.failed { color: var(--bad); border-color: rgba(217,83,79,.35); background: rgba(217,83,79,.08); }
  .badge.inconclusive, .badge.not_evaluated { color: var(--warn); border-color: rgba(224,165,42,.35); background: rgba(224,165,42,.08); }
  .badge.neutral { color: var(--info); border-color: rgba(74,163,223,.35); background: rgba(74,163,223,.08); }
  .badge.muted { color: var(--muted); border-color: var(--border); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; font-weight: 600; }
  td.num, th.num { text-align: right; font-family: var(--mono); }
  .bar { height: 8px; background: var(--panel-2); border-radius: 4px; overflow: hidden; }
  .bar > span { display: block; height: 100%; background: var(--info); }
  .score { font-family: var(--mono); font-size: 44px; font-weight: 700; }
  .score small { font-size: 16px; color: var(--muted); font-weight: 500; }
  .kv { display: grid; grid-template-columns: 180px 1fr; gap: 4px 12px; font-size: 13px; }
  .kv dt { color: var(--muted); } .kv dd { margin: 0; font-family: var(--mono); word-break: break-all; }
  .section { margin-top: 24px; }
  pre { background: #0b1118; border: 1px solid var(--border); border-radius: 6px; padding: 12px; overflow: auto; font-size: 12px; font-family: var(--mono); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; margin-right: 14px; font-size: 12px; color: var(--muted); }
  .legend i { width: 12px; height: 12px; border-radius: 2px; display: inline-block; }
  .domains { display: flex; flex-direction: column; gap: 6px; }
  .domain { display: grid; grid-template-columns: 170px 1fr; gap: 12px; align-items: center; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel-2); }
  .domain.affected { border-color: rgba(224,165,42,.5); }
  .domain.critical { border-color: rgba(47,191,113,.35); }
  .domain.critical.affected { border-color: rgba(217,83,79,.6); }
  .boundary { text-align: center; color: var(--muted); font-size: 11px; letter-spacing: .15em; text-transform: uppercase; padding: 2px 0; border-top: 1px dashed var(--dim); }
  footer { color: var(--dim); font-size: 12px; padding: 24px 40px; border-top: 1px solid var(--border); }
</style>
</head>
<body>
<header>
  <div class="brand">Resilient UAS Lab - Resilience Report - schema {{ report.schema_version }}</div>
  <h1>{{ report.scenario.name }}</h1>
  <div class="mono" style="color: var(--muted); font-size: 12px;">
    run {{ report.run_id }} - adapter {{ report.target.adapter }} ({{ report.target.data_origin }}) - vehicle {{ report.target.vehicle }} - generated {{ report.generated_at.strftime('%Y-%m-%d %H:%M:%S UTC') }}
  </div>
</header>
<main>
  <section class="grid cols-4">
    <div class="panel kpi">
      <div class="label">Benchmark result</div>
      <div class="value"><span class="badge {{ report.result.value }}">{{ report.result.value }}</span></div>
      <div class="sub">{{ report.score.reason }}</div>
    </div>
    <div class="panel kpi">
      <div class="label">Resilience score</div>
      <div class="score">{{ '%.1f' % report.resilience_score }}<small> / 100</small></div>
      <div class="sub">profile "{{ report.score.profile.name }}" - hard gates {{ report.hard_gate_result.value }}</div>
    </div>
    <div class="panel kpi">
      <div class="label">Safety preservation</div>
      <div class="value"><span class="badge {{ 'pass' if report.summary.safety_preservation == 'PASS' else 'fail' }}">{{ report.summary.safety_preservation }}</span></div>
      <div class="sub">loss of control: {{ 'YES' if report.summary.loss_of_control else 'NO' }} - control availability {{ report.metrics.availability.control | pct }}</div>
    </div>
    <div class="panel kpi">
      <div class="label">Fault containment</div>
      <div class="value"><span class="badge {{ 'pass' if report.summary.fault_containment == 'PASS' else 'fail' }}">{{ 'CONTAINED' if report.summary.fault_containment == 'PASS' else 'PROPAGATED' }}</span></div>
      <div class="sub">{{ report.summary.affected_domains }} / {{ domain_order | length }} domains affected - depth {{ report.metrics.propagation.max_propagation_depth }}</div>
    </div>
  </section>

  <section class="section grid cols-2">
    <div class="panel">
      <h2>Summary (observed)</h2>
      <dl class="kv">
        <dt>Mission</dt><dd>{{ 'COMPLETE' if report.summary.mission_complete else 'NOT COMPLETE' }} ({{ report.metrics.mission.completion | pct }})</dd>
        <dt>Faults requested / applied</dt><dd>{{ report.summary.faults_injected }} / {{ report.summary.faults_applied }}</dd>
        <dt>Critical failures</dt><dd>{{ report.summary.critical_failures }}</dd>
        <dt>Recovered subsystems</dt><dd>{{ report.summary.recovered_subsystems }}</dd>
        <dt>Degraded transitions</dt><dd>{{ report.summary.degraded_transitions }}</dd>
        <dt>Mean time to recovery</dt><dd>{{ report.summary.mean_time_to_recovery | duration }}</dd>
        <dt>Time to safe state</dt><dd>{{ report.metrics.recovery.time_to_safe_state | duration }}</dd>
        <dt>Simulation duration</dt><dd>{{ report.run.simulation_duration | duration }} at {{ report.run.speed }}x, seed {{ report.run.seed }}</dd>
        <dt>Run state</dt><dd>{{ report.run.state.value }}{% if report.run.reason %} - {{ report.run.reason }}{% endif %}</dd>
      </dl>
    </div>
    <div class="panel">
      <h2>Score breakdown</h2>
      <table>
        <thead><tr><th>Dimension</th><th class="num">Weight</th><th class="num">Score</th><th>Basis</th></tr></thead>
        <tbody>
        {% for d in report.score.dimensions if d.weight > 0 %}
          <tr>
            <td>{{ d.label }}<div class="bar" style="margin-top:4px"><span style="width: {{ (d.score * 100) | round(1) }}%"></span></div></td>
            <td class="num">{{ d.weight }}</td>
            <td class="num">{{ '%.1f' % d.points }}</td>
            <td style="color: var(--muted)">{{ d.explanation }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      <div style="margin-top: 10px; font-size: 12px; color: var(--muted)">
        Hard gates:
        {% for g in report.score.hard_gates %}<span class="badge {{ 'pass' if g.passed else 'fail' }}" title="{{ g.reason }}">{{ g.name }}</span> {% endfor %}
      </div>
    </div>
  </section>

  <section class="section panel">
    <h2>Assertions</h2>
    <table>
      <thead><tr><th>Expression</th><th>Severity</th><th>Result</th><th>Measured</th><th>Explanation</th></tr></thead>
      <tbody>
      {% for a in report.assertions %}
        <tr>
          <td class="mono">{{ a.expression }}</td>
          <td><span class="badge {{ 'fail' if a.severity.value == 'critical' else 'neutral' }}">{{ a.severity.value }}</span></td>
          <td><span class="badge {{ a.outcome.value }}">{{ a.outcome.value }}</span></td>
          <td class="mono">{{ a.measured if a.measured is not none else 'n/a' }}</td>
          <td style="color: var(--muted)">{{ a.explanation }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5" style="color: var(--muted)">No assertions declared.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="section grid cols-2">
    <div class="panel">
      <h2>Resilience metrics</h2>
      <table>
        <tbody>
          <tr><td>Mission completion</td><td class="num">{{ report.metrics.mission.completion | pct }}</td></tr>
          <tr><td>Mission continuity</td><td class="num">{{ report.metrics.mission.continuity | pct }}</td></tr>
          <tr><td>Control availability</td><td class="num">{{ report.metrics.availability.control | pct }}</td></tr>
          <tr><td>Navigation integrity</td><td class="num">{{ report.metrics.availability.navigation_integrity | pct }}</td></tr>
          <tr><td>Communication availability</td><td class="num">{{ report.metrics.availability.communications | pct }}</td></tr>
          <tr><td>Compute availability</td><td class="num">{{ report.metrics.availability.compute | pct }}</td></tr>
          <tr><td>Mean time to recovery</td><td class="num">{{ report.metrics.recovery.mean_time_to_recovery | duration }}</td></tr>
          <tr><td>Recovery success rate</td><td class="num">{{ report.metrics.recovery.success_rate | pct if report.metrics.recovery.success_rate is not none else 'n/a' }}</td></tr>
          <tr><td>Fault propagation count</td><td class="num">{{ report.metrics.propagation.propagation_count }}</td></tr>
          <tr><td>Affected domains</td><td class="num">{{ report.metrics.propagation.affected_domains | length }}</td></tr>
          <tr><td>Max propagation depth</td><td class="num">{{ report.metrics.propagation.max_propagation_depth }}</td></tr>
          <tr><td>Time nominal / degraded / failed</td><td class="num">{{ report.metrics.modes.time_nominal | duration }} / {{ report.metrics.modes.time_degraded | duration }} / {{ report.metrics.modes.time_failed | duration }}</td></tr>
        </tbody>
      </table>
    </div>
    <div class="panel">
      <h2>Fault propagation</h2>
      <div class="domains">
        {% set affected = report.metrics.propagation.affected_domains | map(attribute='value') | list %}
        {% set injected = report.metrics.propagation.injected_domains | map(attribute='value') | list %}
        {% for domain in domain_order %}
          {% if domain == 'flight_control' %}<div class="boundary">trust boundary</div>{% endif %}
          <div class="domain {{ 'affected' if domain in affected }} {{ 'critical' if domain in ['flight_control', 'actuation'] }}">
            <div class="mono">{{ domain }}</div>
            <div>
              {% if domain in injected %}<span class="badge fail">injected</span>{% endif %}
              {% if domain in affected and domain not in injected %}<span class="badge inconclusive">propagated</span>{% endif %}
              {% if domain not in affected %}<span class="badge pass">protected</span>{% endif %}
              {% for c in report.topology.components if c.domain.value == domain %}
                {% set st = report.metrics.final_component_states.get(c.id) %}
                <span class="badge muted" style="border-color: {{ (st.value if st else 'UNKNOWN') | state_color }}55; color: {{ (st.value if st else 'UNKNOWN') | state_color }}" title="{{ c.name }}">{{ c.id }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
      <p style="margin: 12px 0 0; color: var(--muted); font-size: 12px;">
        Blast radius: <strong style="color: {{ 'var(--ok)' if report.metrics.propagation.contained else 'var(--bad)' }}">{{ 'CONTAINED' if report.metrics.propagation.contained else 'PROPAGATED TO FLIGHT-CRITICAL DOMAIN' }}</strong>.
        Trust boundary crossed: {{ 'yes' if report.metrics.propagation.boundary_crossed else 'no' }}.
      </p>
    </div>
  </section>

  <section class="section panel">
    <h2>Subsystem state timeline</h2>
    {{ timeline_svg | safe }}
    <div class="legend" style="margin-top: 8px">
      {% for name, color in state_colors.items() if name not in ['OPERATIONAL', 'RECOVERED'] %}<span><i style="background: {{ color }}"></i>{{ name }}</span>{% endfor %}
      <span><i style="background: #e6edf3"></i>injection applied</span>
    </div>
  </section>

  <section class="section grid cols-2">
    <div class="panel">
      <h2>Trajectory (top view)</h2>
      {{ path_svg | safe }}
    </div>
    <div class="panel">
      <h2>Recovery records</h2>
      <table>
        <thead><tr><th>Subsystem</th><th>Fault</th><th class="num">Start</th><th class="num">Recovered</th><th class="num">Time</th><th>Attribution</th></tr></thead>
        <tbody>
        {% for r in report.metrics.recovery.records %}
          <tr>
            <td class="mono">{{ r.subsystem }}</td>
            <td><span class="badge muted" style="color: {{ r.fault_state.value | state_color }}">{{ r.fault_state.value }}</span></td>
            <td class="num">{{ r.fault_started_at | mission_time }}</td>
            <td class="num">{{ r.recovered_at | mission_time if r.recovered_at is not none else ('n/a' if not r.recovery_expected else 'not recovered') }}</td>
            <td class="num">{{ r.recovery_time | duration if r.recovery_time is not none else '-' }}</td>
            <td style="color: var(--muted)">{{ 'direct' if r.direct else 'propagated' }}{% if r.caused_by %} ({{ r.caused_by }}){% endif %}{% if not r.recovery_expected %} - effect persisted to scenario end{% endif %}</td>
          </tr>
        {% else %}
          <tr><td colspan="6" style="color: var(--muted)">No fault observed.</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section panel">
    <h2>Event timeline</h2>
    <table>
      <thead><tr><th class="num">Time</th><th>Kind</th><th>Source</th><th>Severity</th><th>Subsystem</th><th>Event</th></tr></thead>
      <tbody>
      {% for e in report.events if e.kind.value != 'LOG' %}
        <tr>
          <td class="num">{{ e.simulation_time | mission_time }}</td>
          <td><span class="badge {{ 'fail' if e.kind.value in ['INJECTION_REJECTED'] else ('neutral' if e.kind.value.startswith('INJECTION') else ('pass' if e.kind.value == 'RECOVERY' else 'muted')) }}">{{ e.kind.value | replace('_', ' ') }}</span></td>
          <td class="mono">{{ e.source.value }}</td>
          <td class="mono">{{ e.severity.value }}</td>
          <td class="mono">{{ e.subsystem or '' }}</td>
          <td>{{ e.message }}{% if e.state_before and e.state_after %} <span class="mono" style="color: var(--muted)">[{{ e.state_before.value }} → {{ e.state_after.value }}]</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="section grid cols-2">
    <div class="panel">
      <h2>Provenance</h2>
      <dl class="kv">
        <dt>Software version</dt><dd>{{ report.provenance.software_version }}</dd>
        <dt>Git commit</dt><dd>{{ report.provenance.git_commit or 'unknown' }}</dd>
        <dt>Scenario hash</dt><dd>{{ report.provenance.scenario_hash }}</dd>
        <dt>Scenario API</dt><dd>{{ report.provenance.scenario_api_version }}</dd>
        <dt>Adapter</dt><dd>{{ report.provenance.adapter }} {{ report.provenance.adapter_version or '' }}</dd>
        <dt>Data origin</dt><dd>{{ report.provenance.data_origin }}</dd>
        <dt>Seed / speed</dt><dd>{{ report.provenance.seed }} / {{ report.provenance.speed }}x</dd>
        <dt>Runner</dt><dd>{{ report.provenance.runner_id or 'unknown' }}</dd>
        {% for k, v in report.provenance.image_versions.items() %}<dt>Image {{ k }}</dt><dd>{{ v }}</dd>{% endfor %}
        {% for k, v in report.provenance.environment.items() %}<dt>{{ k }}</dt><dd>{{ v }}</dd>{% endfor %}
        <dt>Started</dt><dd>{{ report.run.started_at.isoformat() if report.run.started_at else 'n/a' }}</dd>
        <dt>Ended</dt><dd>{{ report.run.ended_at.isoformat() if report.run.ended_at else 'n/a' }}</dd>
      </dl>
    </div>
    <div class="panel">
      <h2>Artifacts</h2>
      <table>
        <thead><tr><th>Name</th><th>Type</th><th class="num">Size</th><th>Storage key</th></tr></thead>
        <tbody>
        {% for a in report.artifacts %}
          <tr><td class="mono">{{ a.name }}</td><td class="mono">{{ a.content_type }}</td><td class="num">{{ a.size_bytes }}</td><td class="mono" style="color: var(--muted)">{{ a.storage_key }}</td></tr>
        {% else %}
          <tr><td colspan="4" style="color: var(--muted)">No artifacts recorded.</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section panel">
    <h2>Executed scenario (canonical YAML)</h2>
    <pre>{{ report.scenario.document }}</pre>
  </section>
</main>
<footer>
  Data origin: {{ report.target.data_origin }}. Values in this report are computed from observed run events and telemetry; requested injections are listed separately from observed effects.
</footer>
</body>
</html>
